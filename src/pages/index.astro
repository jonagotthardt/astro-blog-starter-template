---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import CookieBanner from '../components/CookieBanner.astro';
import { getLatestRelease } from '../lib/github-releases';

const discordInvite = "https://discord.gg/Js3c3ynRRd";
const tarnoRelease = await getLatestRelease('jonagotthardt/tarno-public');
const tarnoAsset = tarnoRelease?.assets.find((a) => a.name.toLowerCase().endsWith('.exe')) ?? null;
const tarnoDownloadUrl = tarnoAsset?.url ?? "https://github.com/jonagotthardt/tarno-public/releases/latest";
---

<html lang="en">
<head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
</head>
<body>
    <Header />

    <main>
        <section class="hero">
            <h1>BuildMC Launcher</h1>
            <p>The custom Minecraft launcher built for modpacks, servers, and seamless multiplayer.</p>
            <a href="./downloads" class="btn btn-primary">Download Launcher</a>
            <a href="./downloads" class="btn btn-secondary">Browse Downloads</a>
        </section>

        <section class="promo-tarno">
            <span class="promo-tarno-eyebrow">Also from us</span>
            <div class="promo-tarno-grid">
                <div>
                    <div class="promo-tarno-heading">
                        <img src="/tarno/icon.png" alt="" loading="lazy" width="56" height="56" />
                        <h2>TARNO</h2>
                    </div>
                    <p class="promo-tarno-meta">{tarnoRelease?.tag ?? 'Beta'} · Windows</p>
                    <p class="promo-tarno-tagline">A personal AI voice assistant for Windows, inspired by Jarvis — talk to it, and it gets things done.</p>
                    <ul class="promo-tarno-features">
                        <li>Native voice control: wake word, natural text-to-speech, and a live voice orb</li>
                        <li>Choose your AI provider: bring your own key (Mistral, Claude, OpenAI, Gemini, Groq, …) or go fully local with Ollama</li>
                        <li>Plugin integrations: Minecraft, Discord, Git, smart home, calendar & email</li>
                        <li>Autonomous routines, reminders, and daily briefings</li>
                        <li>Security-hardened: encryption, PII redaction, zero-trust content filtering</li>
                    </ul>
                    <a href={tarnoDownloadUrl} class="btn btn-primary">Download TARNO for Windows</a>
                </div>
                <div class="promo-tarno-media">
                    <img src="/tarno/screenshot-chat.png" alt="TARNO chat: the assistant introduces itself and offers to read files, search the web, or write code" loading="lazy" width="1920" height="1032" />
                </div>
            </div>
        </section>

        <section>
            <h2>Features</h2>
            <div class="features">
                <div class="feature-card">
                    <h3>Modpack Support</h3>
                    <p>Import and play Modrinth modpacks directly from the launcher.</p>
                </div>
                <div class="feature-card">
                    <h3>Server Integration</h3>
                    <p>Save favorite servers, ping them, and join with one click.</p>
                </div>
                <div class="feature-card">
                    <h3>Account Management</h3>
                    <p>Microsoft account login with secure token storage.</p>
                </div>
                <div class="feature-card">
                    <h3>SwiftServers</h3>
                    <p>Manage your SwiftServers hosting right from the launcher.</p>
                </div>
                <div class="feature-card">
                    <h3>Fabric & Mods</h3>
                    <p>Install Fabric and manage mods per instance automatically.</p>
                </div>
                <div class="feature-card">
                    <h3>Discord Rich Presence</h3>
                    <p>Show your friends what you're playing with Discord activity status.</p>
                </div>
            </div>
        </section>

        <section>
            <h2>Get Started</h2>
            <p>
                Download the latest BuildMC Launcher installer, install it, and start playing on your favorite servers.
                Free, open, and made for the community.
            </p>
            <a href="./downloads" class="btn btn-primary">Download for Windows and Linux</a>
            <a href={discordInvite} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">Join Discord</a>
        </section>
    </main>

    <Footer />
    <CookieBanner />
</body>
</html>
