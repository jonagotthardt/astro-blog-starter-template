---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import CookieBanner from '../../components/CookieBanner.astro';
import fs from 'fs';
import path from 'path';
import { getLatestRelease, platformLabel, formatBytes as formatReleaseBytes } from '../../lib/github-releases';

const buildmcRelease = await getLatestRelease('jonagotthardt/jona');
const alchemieRelease = await getLatestRelease('jonagotthardt/Alchemie-Laden');
const alchemieAsset = alchemieRelease?.assets.find((a) => a.name.toLowerCase().endsWith('.exe')) ?? null;

interface DownloadFile {
  name: string;
  size: string;
  url: string;
  category: string;
}

function formatBytes(bytes: number): string {
  if (bytes === 0) return '0 B';
  const k = 1024;
  const sizes = ['B', 'KB', 'MB', 'GB'];
  const i = Math.floor(Math.log(bytes) / Math.log(k));
  return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
}

function getCategory(filename: string): string {
  const ext = path.extname(filename).toLowerCase();
  if (ext === '.mrpack') return 'Modpacks';
  if (ext === '.jar') return 'Plugins & Mods';
  if (filename.toLowerCase().includes('resourcepack') || filename.toLowerCase().includes('watcherhorrorultimate')) return 'Resource Packs';
  if (filename.toLowerCase().includes('installer') || ext === '.txt') return 'Tools';
  return 'Other';
}

const downloadsDir = path.join(process.cwd(), 'public', 'downloads');
const files: DownloadFile[] = [];

if (fs.existsSync(downloadsDir)) {
  const entries = fs.readdirSync(downloadsDir);
  for (const entry of entries) {
    const fullPath = path.join(downloadsDir, entry);
    const stat = fs.statSync(fullPath);
    if (stat.isFile()) {
      files.push({
        name: entry,
        size: formatBytes(stat.size),
        url: `./${encodeURIComponent(entry)}`,
        category: getCategory(entry),
      });
    }
  }
}

const categories = ['Modpacks', 'Plugins & Mods', 'Resource Packs', 'Tools', 'Other'];
---

<html lang="de">
<head>
    <BaseHead title={`Downloads - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
</head>
<body>
    <Header />

    <main>
        <section class="hero">
            <h1>Downloads</h1>
            <p>Lade den BuildMC Launcher herunter und stöbere durch zusätzliche Plugins, Modpacks und Resource Packs.</p>
        </section>

        <section>
            <h2>BuildMC Launcher</h2>
            {buildmcRelease && buildmcRelease.assets.length > 0 ? (
                <div class="download-list">
                    {buildmcRelease.assets.map((asset) => (
                        <div class="download-item" key={asset.name}>
                            <div>
                                <strong>{platformLabel(asset.name)}</strong>
                                <span style="display: block; color: rgb(var(--gray)); font-size: 0.9rem;">{buildmcRelease.tag} · {formatReleaseBytes(asset.size)}</span>
                            </div>
                            <a href={asset.url}>Herunterladen</a>
                        </div>
                    ))}
                </div>
            ) : (
                <div class="download-item">
                    <div>
                        <strong>BuildMC Launcher Installer</strong>
                        <span style="display: block; color: rgb(var(--gray)); font-size: 0.9rem;">Windows Setup (MSI)</span>
                    </div>
                    <a href="https://github.com/jonagotthardt/jona/releases/latest" target="_blank" rel="noopener noreferrer">Auf GitHub herunterladen</a>
                </div>
            )}
            <p style="color: rgb(var(--gray));">
                Installer werden auf GitHub Releases gehostet, da GitHub Pages Dateigrößenlimits hat.
            </p>
        </section>

        <section>
            <h2>Spiele</h2>
            <div class="game-showcase">
                <div class="game-showcase-media">
                    <span class="game-showcase-badge">Neu</span>
                    <img src="/downloads/games/alchemie-laden/screenshot-shop.png" alt="Alchemie-Laden Gameplay: eine Kundin bittet um ein Gegengift, Zutaten liegen schon im Kessel" loading="lazy" width="940" height="600" />
                </div>
                <div>
                    <div class="game-showcase-heading">
                        <img src="/downloads/games/alchemie-laden/icon.png" alt="" loading="lazy" width="48" height="48" />
                        <h3>Alchemie-Laden</h3>
                    </div>
                    <p class="game-showcase-meta">{alchemieRelease?.tag ?? 'v1.0.0'} · Windows{alchemieAsset ? ` · ${formatReleaseBytes(alchemieAsset.size)}` : ' · ~29 MB'}</p>
                    <p class="game-showcase-tagline">Eine gemütliche Tag-für-Tag-Ladensimulation. Braue aus magischen Zutaten das richtige Rezept, bevor die Geduld deiner Kundschaft aufgebraucht ist.</p>
                    <ul class="game-features">
                        <li>Mehrtägige Kampagne plus Endlos-Modus mit täglichen Ereignissen (gesperrte Zutaten, Gold-Boni und mehr)</li>
                        <li>Kindermodus: druckfreie Lernphase und deutlich mehr Geduld, extra für jüngere Spieler:innen</li>
                        <li>2-Spieler-Online-Multiplayer — kooperativ oder gegeneinander</li>
                        <li>Aufwertungen, Erfolge und ein Serien-Bonus für aufeinanderfolgende Erfolge</li>
                    </ul>
                    <a href={alchemieAsset?.url ?? "https://github.com/jonagotthardt/Alchemie-Laden/releases/latest"} class="btn btn-primary">Für Windows herunterladen</a>
                </div>
            </div>
        </section>

        <section>
            {categories.map((category) => {
                const items = files.filter((f) => f.category === category);
                if (items.length === 0) return null;
                return (
                    <div key={category}>
                        <h2>{category}</h2>
                        <div class="download-list">
                            {items.map((file) => (
                                <div class="download-item" key={file.name}>
                                    <div>
                                        <strong>{file.name}</strong>
                                        <span style="display: block; color: rgb(var(--gray)); font-size: 0.9rem;">{file.size}</span>
                                    </div>
                                    <a href={file.url} download>Herunterladen</a>
                                </div>
                            ))}
                        </div>
                    </div>
                );
            })}
        </section>
    </main>

    <Footer />
    <CookieBanner />
</body>
</html>
